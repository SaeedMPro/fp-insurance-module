# Copy to deploy/.env and adjust before running `make up`.
# These three vars are the only ones deploy/docker-compose.yml interpolates
# from the environment; everything else is hard-coded there.

# Signing secret for JWT access tokens issued by the backend.
# change-this-in-production
JWT_SECRET=change-this-in-production

# Origin(s) the backend's CORS middleware allows (the URL the frontend is
# actually served from).
CORS_ORIGIN=http://localhost:5173

# Base URL the frontend is built against. Vite inlines this at build time,
# so changing it requires rebuilding the frontend image.
VITE_API_BASE_URL=http://localhost:8080/api/v1
